{
    "suggest.noselect": true,
    "suggest.preferCompleteThanJumpPlaceholder": true,
    "clangd": {
        "enabled": true,
        "arguments": [
            "--background-index",
            "--clang-tidy",
            "-j=4",
            "--log",
            "verbose"
        ],
        "rootPatterns": [
            "compile_commands.json",
            "build/"
        ],
        "fallbackFlags": [
            "/std=c++latest",
            "-std=c++23",
            "-Wall",
            "-Wextra"
        ]
    },
    "languageserver": {
      "fortran": {
        "command": "fortls",
        "filetypes": ["fortran", "F", "f90"],
        "rootPatterns": [".fortls", ".git/"]
      }
    }
}
